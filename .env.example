# TradeJournal Windows Agent configuration.
# This file contains placeholders only. Never store tokens or MT5 credentials here.

# Control-plane endpoints. HTTPS is mandatory outside loopback tests.
TRADEJOURNAL_API_URL=https://<project-ref>.functions.supabase.co/trading-agent
TRADEJOURNAL_TRADING_INGESTION_URL=https://<project-ref>.functions.supabase.co/trading-mt5-events

# Poll interval used when no job is available.
TRADEJOURNAL_POLL_SECONDS=5

# Local Windows layout.
TRADEJOURNAL_SECRETS_ROOT=C:\TradeJournal\secrets
TRADEJOURNAL_INSTANCES_ROOT=C:\TradeJournal\instances
TRADEJOURNAL_SOURCE_TERMINAL=C:\TradeJournal\mt5-template\terminal64.exe
TRADEJOURNAL_EXPERT_BINARY=C:\TradeJournal\mt5-template\MQL5\Experts\TradeJournal\TradeJournalBridge.ex5
TRADEJOURNAL_BROKER_REGISTRY=C:\TradeJournal\broker-registry\endpoint-registry.json
TRADEJOURNAL_BROKER_ARTIFACT_ROOT=C:\TradeJournal\broker-registry
TRADEJOURNAL_BROKER_ARTIFACT_MANIFEST=C:\TradeJournal\broker-registry\artifact-manifest.json

# Mandatory SHA-256 pins for the approved terminal template and read-only EA.
TRADEJOURNAL_MT5_TEMPLATE_SHA256=<64-lowercase-hex-characters>
TRADEJOURNAL_MT5_EXPERT_SHA256=<64-lowercase-hex-characters>

# MT5 runs in a separate interactive desktop session so no terminal window is visible in the
# Administrator/RDP session. This must be a dedicated least-privilege local account kept logged
# in (a disconnected session is sufficient); built-in administrator/service identities fail closed.
TRADEJOURNAL_MT5_INTERACTIVE_USER=TradeJournalMT5

# Explicit opt-in for credential-free "Find your broker" census when no VERIFIED endpoint exists.
# The wizard runs only in the dedicated interactive session and must finish before the encrypted
# investor credential is decrypted. Promotion still requires a successful read-only login.
TRADEJOURNAL_MT5_WIZARD_ENABLED=0

# Optional safe startup symbol. It must exist for every intended broker template.
TRADEJOURNAL_MT5_STARTUP_SYMBOL=EURUSD

# Optional broker-identity resolver for a server not yet present in the VERIFIED catalog.
# The SDK reads OPENAI_API_KEY exclusively from the host environment/secret manager: never put
# the key in this file. Only the MT5 server identifier is sent; credentials and account data are
# never included. A suggestion still requires a separately VERIFIED endpoint and a successful
# investor login before the control plane can promote the server/broker pair.
# OPENAI_API_KEY=<host-environment-only>
TRADEJOURNAL_BROKER_IDENTITY_CACHE=C:\TradeJournal\broker-registry\broker-identity-cache.json
TRADEJOURNAL_BROKER_IDENTITY_CACHE_TTL_SECONDS=86400
TRADEJOURNAL_BROKER_IDENTITY_MODEL=gpt-5.6
